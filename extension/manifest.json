{
  "manifest_version": 3,
  "name": "StitchMatrix — Script Matrix Studio",
  "version": "3.8.1",
  "description": "Qubora Emerald Obsidian Organic Distribution Suite & In-DOM Script Matrix Studio for TikTok, YouTube Shorts, and Instagram Reels",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "StitchMatrix — Toggle Script Matrix Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://stitchmatrix-api.humangeek77.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.youtube.com/*",
        "https://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle the StitchMatrix Sidebar Studio"
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle StitchMatrix Sidebar"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icons/*"],
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.youtube.com/*",
        "https://*.instagram.com/*"
      ]
    }
  ]
}
